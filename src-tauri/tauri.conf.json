{
  "productName": "WCS智能诊断",
  "version": "1.0.0",
  "identifier": "cn.aimstek.loong.aidiag",
  "build": {
    "frontendDist": "../src/main/resources/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WCS 任务智能诊断",
        "url": "loading.html",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/*"],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
